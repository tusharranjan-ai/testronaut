# Optional — required for BOTH the "anthropic" and "claude_agent_sdk" providers.
# The Agent SDK needs a real API key; a Claude subscription is not a sanctioned
# auth path for SDK-built agents. See docs/PLAN.md §3.
ANTHROPIC_API_KEY=

# Optional — only for the "openai" provider.
OPENAI_API_KEY=

# Defaults shown. Ollama is the default provider: free, offline, no key.
OLLAMA_BASE_URL=http://localhost:11434
TESTRONAUT_DEFAULT_PROVIDER=ollama
TESTRONAUT_DB=sqlite:///./testronaut.db

# OmniRoute (https://github.com/diegosouzapw/OmniRoute) — self-hosted, OpenAI-
# compatible gateway to 350+ providers. No key needed for its "auto" model;
# OMNIROUTE_API_KEY is only for a gateway you've secured with one.
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=

# How many endpoints are generated/reviewed at once. Optional: when unset, the
# default depends on the provider (1 for Ollama, 2 for the Agent SDK, 4 for hosted
# APIs). Setting it here overrides that for every provider, so leave it commented
# unless you have a reason. A local model is usually happier at 1-2.
# TESTRONAUT_MAX_CONCURRENCY=2

# Off by default. Set to 1 to let "fetch a spec by URL" reach private addresses
# (localhost, your LAN). Only do this on a machine you trust.
# TESTRONAUT_ALLOW_PRIVATE_URLS=1
